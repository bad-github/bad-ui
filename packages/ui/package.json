{
  "name": "@workspace/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@turbo/gen": "^2.11.10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./providers": "./src/providers/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./lib": "./src/lib/index.ts",
    "./styles": {
      "types": "./src/styles/index.d.ts",
      "default": "./src/styles/index.css"
    },
    "./styles/themes": {
      "types": "./src/styles/themes/index.d.ts",
      "default": "./src/styles/themes/index.css"
    },
    "./styles/base-color": {
      "types": "./src/styles/base-color/index.d.ts",
      "default": "./src/styles/base-color/index.css"
    },
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./providers/*": "./src/providers/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  }
}
