{
  "name": "@badnpm/ui",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "build": "rollup -c"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@fontsource-variable/geist": "^5.3.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4",
    "@turbo/gen": "^2.11.10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "postcss": "^8.5.32",
    "postcss-url": "^10.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.68.2",
    "rollup-plugin-dts": "6.5.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tslib": "^2.9.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      },
      "default": "./dist/esm/index.js"
    },
    "./styles/index.css": "./dist/styles/index.css",
    "./styles/body.css": "./dist/styles/body.css",
    "./styles/font/geist.css": "./dist/styles/font/geist.css",
